# ── データベース (Neon PostgreSQL) ──────────────────────────
# Neon ダッシュボード → Connection Details → Pooled connection
DATABASE_URL="postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Neon ダッシュボード → Connection Details → Direct connection (migration 用)
DIRECT_URL="postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth ────────────────────────────────────────────────
NEXTAUTH_URL=https://your-app.vercel.app
# openssl rand -base64 32 で生成
NEXTAUTH_SECRET=your-random-secret-here

# ── メール (本番用 SMTP, 開発時は MAIL_MOCK=true でOK) ──────
MAIL_MOCK=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-gmail@gmail.com
