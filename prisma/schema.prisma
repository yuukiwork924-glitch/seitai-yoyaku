generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── NextAuth v4 必須テーブル ──────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── ユーザー（顧客・管理者共通） ─────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String?
  role         String   @default("CUSTOMER")
  isFirstVisit Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  reservations      Reservation[]
  pointTransactions PointTransaction[]
  medicalRecords    MedicalRecord[]
  intakeForm        IntakeForm?
}

// ─── スタッフ ──────────────────────────────────────────────

model Staff {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  bio       String?
  avatarUrl String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules    StaffSchedule[]
  reservations Reservation[]
}

model StaffSchedule {
  id        String  @id @default(cuid())
  staffId   String
  date      String  // "YYYY-MM-DD"
  startTime String  // "09:00"
  endTime   String  // "18:00"
  isOff     Boolean @default(false)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
}

// ─── 施術メニュー ─────────────────────────────────────────

model Menu {
  id          String   @id @default(cuid())
  name        String
  description String?
  duration    Int
  price       Int
  category    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservations Reservation[]
}

// ─── 予約 ─────────────────────────────────────────────────

model Reservation {
  id           String   @id @default(cuid())
  userId       String
  staffId      String?
  menuId       String
  startTime    DateTime
  endTime      DateTime
  status       String   @default("CONFIRMED")
  isFirstVisit Boolean  @default(false)
  pointsUsed   Int      @default(0)
  internalNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  staff            Staff?            @relation(fields: [staffId], references: [id])
  menu             Menu              @relation(fields: [menuId], references: [id])
  medicalRecord    MedicalRecord?
  pointTransaction PointTransaction?
}

// ─── ポイント ─────────────────────────────────────────────

model PointTransaction {
  id            String   @id @default(cuid())
  userId        String
  reservationId String?  @unique
  delta         Int
  balance       Int
  description   String
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])
}

// ─── カルテ ───────────────────────────────────────────────

model MedicalRecord {
  id            String   @id @default(cuid())
  userId        String
  reservationId String   @unique
  symptoms      String?
  treatment     String?
  staffNote     String?
  nextPlan      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])
}

// ─── 初回問診票 ───────────────────────────────────────────

model IntakeForm {
  id             String   @id @default(cuid())
  userId         String   @unique
  birthDate      String?
  gender         String?
  occupation     String?
  chiefComplaint String?
  medicalHistory String?
  medications    String?
  allergies      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ─── 営業設定 ─────────────────────────────────────────────

model BusinessSettings {
  id                String @id @default(cuid())
  clinicName        String @default("整体院")
  openTime          String @default("09:00")
  closeTime         String @default("19:00")
  slotIntervalMin   Int    @default(60)
  maxConcurrent     Int    @default(1)
  cancelDeadlineHrs Int    @default(24)
  pointPerVisit     Int    @default(1)
  pointToYen        Int    @default(100)
  address           String @default("")
  phone             String @default("")
  description       String @default("")

  closedDays ClosedDay[]
}

model ClosedDay {
  id         String  @id @default(cuid())
  settingsId String
  date       String  // "YYYY-MM-DD"
  reason     String?

  settings BusinessSettings @relation(fields: [settingsId], references: [id])

  @@unique([settingsId, date])
}
